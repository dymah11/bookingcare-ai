# Copy file này thành .env ở thư mục gốc rồi điền giá trị thật.
# .env đã được gitignore — KHÔNG commit secret.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
PORT=3001

# --- Frontend ---
API_BASE_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:5173

# --- Gemini (một key dùng cho cả trợ lý, judge và embedding) ---
# Lấy ở https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model trợ lý hội thoại
# Lưu ý: gemini-2.5-flash trả 404 "no longer available to new users" với key mới.
GEMINI_MODEL=gemini-3.8-flash
# Model dự phòng, cách nhau bằng dấu phẩy. Khi model chính lỗi (503 quá tải,
# 429 hết quota, 404 model không còn dùng được) sẽ thử lần lượt các model này.
# Chạy `pnpm models` để xem model id nào key của bạn được cấp quyền (không tốn quota).
GEMINI_MODEL_FALLBACKS=
# Model judge dùng khi chấm chất lượng
GEMINI_JUDGE_MODEL=gemini-3.8-flash
# Model embedding cho tìm kiếm lai
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Bật/tắt nhánh embedding khi dựng index. Tắt → BM25-only (dựng tức thì, không tốn quota).
INDEX_EMBEDDINGS=true
# Quota embed-content mỗi phút (free tier Gemini: 100). Giảm nếu gặp lỗi 429.
EMBEDDING_RATE_PER_MINUTE=100
# Suy luận: dòng Gemini 3+ dùng thinkingLevel (low|medium|high), viết HOA.
# Dòng Gemini 2.5 (mặc định) dùng GEMINI_THINKING_BUDGET bên dưới.
GEMINI_THINKING_LEVEL=medium
# Ngân sách suy luận cho dòng Gemini 2.5 (số token). Phải < maxOutputTokens (500).
GEMINI_THINKING_BUDGET=256
# Số lượt hội thoại gần nhất được giữ nguyên văn trong lịch sử
CHAT_HISTORY_TURNS=6
# Câu hỏi tra cứu được trả thẳng từ index, KHÔNG gọi model (0 request, tức thì).
# Tắt nếu muốn mọi lượt đều do Gemini trả lời (tốn quota hơn nhiều).
ASSISTANT_DIRECT_SEARCH=true

# --- Data pipeline ---
DATA_DIR=./data
BOOKINGCARE_BASE_URL=https://bookingcare.vn

# --- Crawler ---
CRAWL_MAX_PAGES=200
CRAWL_USER_AGENT=bookingcare-ai/0.1
# Số request đồng thời (giữ <= 2 để tôn trọng website nguồn)
CRAWL_CONCURRENCY=2
# Delay giữa 2 request (ms), có jitter trong khoảng [min, max]
CRAWL_DELAY_MIN_MS=1000
CRAWL_DELAY_MAX_MS=2000
# Thời gian chờ thêm cho trang render JS (ms)
CRAWL_SETTLE_MS=800
# Retry + backoff
CRAWL_RETRIES=3
CRAWL_BACKOFF_MS=800
CRAWL_TIMEOUT_MS=30000
CRAWL_HEADLESS=true
