# Copy file này thành .env ở thư mục gốc rồi điền giá trị thật.
# .env đã được gitignore — KHÔNG commit secret.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
PORT=3001

# --- Frontend ---
API_BASE_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:5173

# --- Assistant (Claude Haiku 5.5) ---
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
# Mức reasoning: low | medium | high
ASSISTANT_EFFORT=medium

# --- Judge / eval (GPT-5.4) ---
OPENAI_API_KEY=
JUDGE_MODEL=gpt-5.4

# --- Embedding (tìm kiếm lai) ---
# Cần OPENAI_API_KEY. Thiếu key thì tìm kiếm chỉ dùng BM25.
EMBEDDING_MODEL=text-embedding-3-small

# --- Data pipeline ---
DATA_DIR=./data
BOOKINGCARE_BASE_URL=https://bookingcare.vn

# --- Crawler ---
CRAWL_MAX_PAGES=200
CRAWL_USER_AGENT=bookingcare-ai/0.1 (+https://example.invalid/bot)
# Số request đồng thời (giữ <= 2 để tôn trọng website nguồn)
CRAWL_CONCURRENCY=2
# Delay giữa 2 request (ms), có jitter trong khoảng [min, max]
CRAWL_DELAY_MIN_MS=1000
CRAWL_DELAY_MAX_MS=2000
# Thời gian chờ thêm cho trang render JS (ms)
CRAWL_SETTLE_MS=800
# Retry + backoff
CRAWL_RETRIES=3
CRAWL_BACKOFF_MS=800
CRAWL_TIMEOUT_MS=30000
CRAWL_HEADLESS=true
